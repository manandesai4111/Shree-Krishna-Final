generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PROPERTY_OWNER
  STAFF
}

enum RoomStatus {
  VACANT
  PARTIAL
  OCCUPIED
  MAINTENANCE
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum PaymentType {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum DepositType {
  RECEIVED
  RETURNED
  ADJUSTED
}

enum DocumentType {
  AADHAAR
  PASSPORT
  DRIVING_LICENCE
  AGREEMENT
  ADDRESS_PROOF
  OTHER
}

model TenantAccount {
  id         String     @id @default(cuid())
  name       String
  country    String     @default("IN")
  currency   String     @default("INR")
  users      User[]
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model User {
  id            String        @id @default(cuid())
  tenantId      String?
  tenant        TenantAccount? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  email         String        @unique
  passwordHash  String
  role          UserRole      @default(PROPERTY_OWNER)
  isActive      Boolean       @default(true)
  ownedProperties Property[]  @relation("PropertyOwner")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
}

model Property {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    TenantAccount @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User          @relation("PropertyOwner", fields: [ownerId], references: [id])
  name      String
  address   String
  city      String
  state     String
  country   String        @default("IN")
  rooms     Room[]
  residents Resident[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([ownerId])
}

model Room {
  id        String       @id @default(cuid())
  tenantId  String
  propertyId String
  property  Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number    String
  capacity  Int
  occupied  Int          @default(0)
  status    RoomStatus   @default(VACANT)
  rentAmount Decimal     @db.Decimal(12, 2)
  notes     String?
  residents Resident[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([propertyId, number])
  @@index([tenantId])
}

model Resident {
  id                  String        @id @default(cuid())
  tenantId            String
  propertyId          String
  property            Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId              String?
  room                Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  fullName            String
  mobileNumber        String
  email               String?
  address             String
  emergencyContact    String
  governmentIdType    String
  governmentIdNumber  String
  moveInDate          DateTime
  moveOutDate         DateTime?
  monthlyRent         Decimal       @db.Decimal(12, 2)
  depositAmount       Decimal       @db.Decimal(12, 2)
  notes               String?
  photoObjectKey      String?
  payments            Payment[]
  deposits            Deposit[]
  documents           Document[]
  activityLogs        ActivityLog[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([roomId])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  residentId  String
  resident    Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  paymentType PaymentType
  status      PaymentStatus @default(PAID)
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([tenantId])
  @@index([residentId])
}

model Deposit {
  id          String      @id @default(cuid())
  tenantId    String
  residentId  String
  resident    Resident    @relation(fields: [residentId], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(12, 2)
  type        DepositType
  notes       String?
  recordedAt  DateTime    @default(now())

  @@index([tenantId])
  @@index([residentId])
}

model Document {
  id              String       @id @default(cuid())
  tenantId        String
  residentId      String
  resident        Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type            DocumentType
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageDriver   String
  objectKey       String
  uploadedById    String
  uploadedAt      DateTime     @default(now())

  @@index([tenantId])
  @@index([residentId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  tenantId    String
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  actorId     String?
  event       String
  description String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([residentId])
}
